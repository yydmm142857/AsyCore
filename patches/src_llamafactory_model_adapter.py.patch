+def _asymcore_load_trainable_state(model, state_path: str):
+    import json
+    import torch
+    from pathlib import Path
+
+    path = Path(state_path)
+    if not path.is_file():
+        raise FileNotFoundError(f"[AsymCore] asymcore_state_path not found: {path}")
+
+    obj = torch.load(str(path), map_location="cpu")
+    state = obj.get("state_dict", obj) if isinstance(obj, dict) else obj
+
+    if not isinstance(state, dict):
+        raise ValueError(f"[AsymCore] Invalid asymcore state format: {type(state)}")
+
+    raw_model = model.module if hasattr(model, "module") else model
+    params = dict(raw_model.named_parameters())
+
+    loaded = 0
+    verified = 0
+    skipped = []
+    mismatched = []
+    max_abs_diff = 0.0
+    loaded_names = []
+
+    for name, tensor in state.items():
+        if name not in params:
+            skipped.append(name)
+            continue
+
+        param = params[name]
+        if tuple(param.shape) != tuple(tensor.shape):
+            mismatched.append((name, tuple(tensor.shape), tuple(param.shape)))
+            continue
+
+        src = tensor.to(device=param.device, dtype=param.dtype)
+        param.data.copy_(src)
+        loaded += 1
+        loaded_names.append(name)
+
+        with torch.no_grad():
+            diff = (param.detach() - src).abs().max().item()
+            max_abs_diff = max(max_abs_diff, float(diff))
+            if diff == 0.0:
+                verified += 1
+
+    total = len(state)
+    report = {
+        "state_path": str(path),
+        "format": obj.get("format", "unknown") if isinstance(obj, dict) else "raw",
+        "num_tensors_in_file": total,
+        "loaded": loaded,
+        "verified_exact": verified,
+        "skipped": len(skipped),
+        "mismatched": len(mismatched),
+        "max_abs_diff_after_copy": max_abs_diff,
+        "first_loaded_names": loaded_names[:20],
+        "first_skipped_names": skipped[:20],
+        "first_mismatched": mismatched[:20],
+        "note": "U_ref/V_ref buffers are reconstructed from source LoRA adapters; trainable AsymCore parameters are loaded from this state file.",
+    }
+
+    report_path = path.parent / "asymcore_load_report.json"
+    try:
+        report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+    except Exception as e:
+        logger.warning_rank0(f"[AsymCore] Failed to write load report: {e}")
+
+    logger.info_rank0(
+        f"[AsymCore] loaded trainable inference state: "
+        f"state={path}, loaded={loaded}/{total}, verified_exact={verified}/{total}, "
+        f"skipped={len(skipped)}, mismatched={len(mismatched)}, "
+        f"max_abs_diff={max_abs_diff:.3e}, report={report_path}. "
+        f"U/V buffers are reconstructed from source LoRA adapters; trainable params are overwritten by asymcore_state.pt."
+    )
+
+    if loaded == 0:
+        raise RuntimeError("[AsymCore] No trainable AsymCore tensors were loaded. Check parameter names.")
+
+    if loaded != total or mismatched:
+        logger.warning_rank0(
+            f"[AsymCore] State not fully loaded: loaded={loaded}/{total}, "
+            f"skipped_examples={skipped[:5]}, mismatched_examples={mismatched[:5]}"
+        )
+
+    return model
+
+
+def _asymcore_force_frozen_base_to_bf16(model):
+    import torch
+
+    converted = 0
+    old_bytes = 0
+
+    for name, param in model.named_parameters():
+        if (not param.requires_grad) and param.is_floating_point() and param.dtype == torch.float16:
+            old_bytes += param.numel() * param.element_size()
+            param.data = param.data.to(torch.bfloat16)
+            converted += 1
+
+    logger.info_rank0(
+        f"[AsymCore] Forced frozen fp16 params to bf16: tensors={converted}, "
+        f"approx_old_bytes={old_bytes / 1024**3:.3f}GB"
+    )
+    return model
+
