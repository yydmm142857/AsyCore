+        train_result = trainer.train(
+            resume_from_checkpoint=training_args.resume_from_checkpoint
+        )
+
+        if mix_mode_for_update_audit == "asymcore":
+            import json
+            from pathlib import Path
+
+            current_parameters = dict(model.named_parameters())
+            tensor_reports = []
+            changed_tensors = 0
+            total_numel = 0
+            changed_numel = 0
+            global_max_abs_update = 0.0
+
+            for name, before in asymcore_update_before.items():
+                if name not in current_parameters:
+                    raise RuntimeError(
+                        f"[AsymCore] Trainable parameter disappeared: {name}"
+                    )
+
+                after = (
+                    current_parameters[name]
+                    .detach()
+                    .float()
+                    .cpu()
+                )
+
+                if tuple(before.shape) != tuple(after.shape):
+                    raise RuntimeError(
+                        f"[AsymCore] Shape changed for {name}: "
+                        f"{tuple(before.shape)} -> {tuple(after.shape)}"
+                    )
+
+                diff = (after - before).abs()
+
+                if not bool(diff.isfinite().all()):
+                    raise RuntimeError(
+                        f"[AsymCore] Non-finite update detected: {name}"
+                    )
+
+                max_abs = float(diff.max().item()) if diff.numel() else 0.0
+                mean_abs = float(diff.mean().item()) if diff.numel() else 0.0
+                changed = max_abs > 0.0
+                numel = int(diff.numel())
+
+                total_numel += numel
+                if changed:
+                    changed_tensors += 1
+                    changed_numel += int((diff > 0).sum().item())
+
+                global_max_abs_update = max(
+                    global_max_abs_update,
+                    max_abs,
+                )
+
+                tensor_reports.append(
+                    {
+                        "name": name,
+                        "shape": list(diff.shape),
+                        "numel": numel,
+                        "changed": changed,
+                        "max_abs_update": max_abs,
+                        "mean_abs_update": mean_abs,
+                    }
+                )
+
+            tensor_reports.sort(
+                key=lambda item: item["max_abs_update"],
+                reverse=True,
+            )
+
+            update_report = {
+                "status": (
+                    "PARAMETERS_UPDATED"
+                    if changed_tensors > 0
+                    else "NO_PARAMETER_UPDATE"
+                ),
+                "captured_tensors": len(asymcore_update_before),
+                "changed_tensors": changed_tensors,
+                "unchanged_tensors": (
+                    len(asymcore_update_before) - changed_tensors
+                ),
+                "total_numel": total_numel,
+                "changed_numel": changed_numel,
+                "global_max_abs_update": global_max_abs_update,
+                "top_updates": tensor_reports[:30],
+                "all_tensors": tensor_reports,
+            }
+
+            update_path = (
+                Path(training_args.output_dir)
+                / "asymcore_update_report.json"
+            )
+            update_path.parent.mkdir(parents=True, exist_ok=True)
+            update_path.write_text(
+                json.dumps(
+                    update_report,
+                    indent=2,
+                    ensure_ascii=False,
+                ),
+                encoding="utf-8",
+            )
+
+            logger.info_rank0(
+                f"[AsymCore] ASYMCORE_UPDATE_AUDIT: "
+                f"changed={changed_tensors}/"
