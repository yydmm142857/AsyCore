+    # Capture the initial trainable AsymCore state so that every run can
+    # verify that backward + optimizer steps changed the fusion parameters.
+    asymcore_update_before = {}
+    mix_mode_for_update_audit = str(
+        getattr(finetuning_args, "lora_mix_mode", "default")
+    ).lower()
+
+    if training_args.do_train and mix_mode_for_update_audit == "asymcore":
+        asymcore_trainable_keys = (
+            "gate_W_",
+            "gate_b_",
