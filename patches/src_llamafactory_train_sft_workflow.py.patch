+                asymcore_update_before[name] = (
+                    param.detach().float().cpu().clone()
+                )
+
+        if not asymcore_update_before:
+            raise RuntimeError(
+                "[AsymCore] No trainable fusion parameters were found "
+                "before training."
+            )
+
+        logger.info_rank0(
