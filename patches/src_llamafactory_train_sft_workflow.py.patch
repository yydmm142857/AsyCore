+            "gate_residual_B_",
+            "asymcore_C_",
+            "asymcore_R_",
+            "asymcore_Cshared_",
+            "asymcore_Rshared_",
+        )
+        for name, param in model.named_parameters():
+            if param.requires_grad and any(
